{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mutabor",
  "version": "0.1.0",
  "identifier": "io.github.dec3n7.mutabor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "menu",
        "title": "Mutabor",
        "url": "index.html",
        "width": 340,
        "height": 460,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "center": false
      },
      {
        "label": "toast",
        "title": "Mutabor",
        "url": "toast.html",
        "width": 340,
        "height": 180,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "focus": false
      },
      {
        "label": "settings",
        "title": "Mutabor",
        "url": "settings.html",
        "width": 520,
        "height": 720,
        "minWidth": 440,
        "minHeight": 420,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "app",
      "dmg",
      "deb",
      "appimage"
    ],
    "category": "Utility",
    "shortDescription": "Offline file converter",
    "license": "GPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/mutabor-ffmpeg"
    ],
    "publisher": "Dec3n7",
    "homepage": "https://github.com/Dec3n7/mutabor",
    "copyright": "© 2026 Dec3n7 and contributors, GPL-3.0-or-later",
    "longDescription": "Select files, press Ctrl+Alt+C (⌘⌥C on a Mac) and pick an action: convert, compress to a size limit, trim, rotate, merge PDFs. Works offline.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Russian",
          "Ukrainian",
          "Spanish",
          "PortugueseBR",
          "German",
          "French",
          "Italian",
          "Polish",
          "Turkish",
          "SimpChinese",
          "Japanese",
          "Korean"
        ],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": [
          "en-US",
          "ru-RU"
        ]
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": [
          "libxdo3"
        ]
      }
    }
  }
}
